# Cloudflare Pages redirects
# Format: /from /to [status]

# Tutorial routes (clean URLs → .html files)
/tutorials/unfollow /tutorials/unfollow.html 200
/tutorials/automation /tutorials/automation.html 200
/tutorials/monitoring /tutorials/monitoring.html 200
/tutorials/scrapers /tutorials/scrapers.html 200
/tutorials/scrapers-full /tutorials/scrapers-full.html 200
/tutorials/mcp /tutorials/mcp.html 200
/tutorials/communities /tutorials/communities.html 200
/tutorials /tutorials/index.html 200

# Clean URL routes
# /mcp is the hosted MCP server (functions/mcp.js), which hands a browser the
# page below. This rule keeps the page reachable at /mcp even when the function
# is not deployed. Pages Functions take precedence, so the function wins when
# it is there. The page cannot be named mcp.html: that would make the asset
# handler canonicalise /mcp back to itself and loop.
/mcp /mcp-docs 200

/login /login.html 200
/pricing /pricing.html 200
/about /about.html 200
/docs /docs.html 200
/privacy /privacy.html 200
/terms /terms.html 200
/features /features.html 200
/run /run.html 200
/admin /admin.html 200
/ai /ai.html 200
/ask /ask.html 200
/ai-api /ai-api.html 200
/monitor /monitor.html 200
/automations /automations.html 200
/workflows /workflows.html 200
/agent /agent.html 200
/unfollowers /unfollowers.html 200
/analytics /analytics.html 200
/calendar /calendar.html 200

# /api/* is served by Pages Functions (functions/api/), not by a redirect.
# Cloudflare Pages rejects a 200-proxy rule that points at another origin
# ("Proxy (200) redirects can only point to relative paths"), so the rule that
# used to live here never took effect. functions/api/[[path]].js forwards to
# XACTIONS_API_ORIGIN when that variable is set on the Pages project, and
# answers a JSON 503 when it is not.
