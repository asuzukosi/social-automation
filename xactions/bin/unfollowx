#!/usr/bin/env node
// Copyright (c) 2024-2026 nich (@nichxbt). Licensed under the Apache License, Version 2.0.
/**
 * `unfollowx` — the original entry point, kept as a pointer to the real CLI.
 *
 * This name predates `xactions`. Anyone who installed XActions for its unfollow
 * scripts may still have it on their PATH, so it stays; it now forwards to the
 * equivalent `xactions` command instead of printing a directory listing.
 *
 *   unfollowx              ->  xactions non-followers
 *   unfollowx <args...>    ->  xactions <args...>
 *
 * It used to be dead on arrival: line 2 was a `#` shell comment inside a Node
 * file, which only line 1 tolerates, so every invocation ended in a SyntaxError
 * before reaching line 3 (which used CommonJS `require` in an ESM package).
 *
 * @author nich (@nichxbt) - https://github.com/nirholas
 * @license Apache-2.0
 */

import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';

const here = dirname(fileURLToPath(import.meta.url));
const cli = join(here, '..', 'src', 'cli', 'index.js');

// Bare `unfollowx` should do what the name promises rather than print help.
if (process.argv.length <= 2) {
  process.argv.push('non-followers');
}

console.error(`note: unfollowx is now xactions. Running: xactions ${process.argv.slice(2).join(' ')}`);

await import(pathToFileURL(cli).href);
