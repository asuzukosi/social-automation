# Cloudflare Pages auto-serves foo.html at /foo and auto-indexes directories
# with an index.html (verified: /about, /docs, /tutorials, /blog, /scripts
# all resolve correctly without an explicit rule). Only true edge cases and
# the API proxy need a rule here.

# Wildcard thread viewer: /thread/<id> all serve the same SPA shell
/thread/:id /thread.html 200

# /api/* is served by Pages Functions (functions/api/), not by a redirect.
# A 200-proxy rule pointing at another origin is rejected by Pages, so the
# rule that used to live here never took effect. functions/api/[[path]].js
# forwards to XACTIONS_API_ORIGIN when that variable is set on the Pages
# project, and answers a JSON 503 when it is not.

# /mcp is the hosted MCP server (functions/mcp.js), which hands a browser the
# page below. This rule keeps the page reachable at /mcp even when the function
# is not deployed. Pages Functions take precedence, so the function wins when
# it is there. The page cannot be named mcp.html: that would make the asset
# handler canonicalise /mcp back to itself and loop.
/mcp /mcp-docs 200
